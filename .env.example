# Copy to .env for reference, then set these variables in your shell.
# Django does not load .env automatically. Never reuse local/CI values for staging.
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generate-a-unique-local-secret>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# HSTS lifetime in seconds for staging/production (default 3600; ignored as 0 in development/test).
# Raise it in steps, e.g. 86400 then 31536000, once HTTPS has been stable. Subdomains and preload stay off.
# DJANGO_HSTS_SECONDS=3600
POSTGRES_DB=<local-database-name>
POSTGRES_USER=<local-database-user>
POSTGRES_PASSWORD=<local-database-password>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional Staff invitation delivery. Leave unset to disable issuance.
# Development may use explicit localhost HTTP; staging/production require HTTPS.
STAFF_INVITATION_PUBLIC_ORIGIN=http://localhost:8000
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=verified-sender@example.com

# Password reset uses STAFF_INVITATION_PUBLIC_ORIGIN and the same SMTP settings.
# Its in-process dispatcher is bounded; SMTP timeout is 10 seconds.
