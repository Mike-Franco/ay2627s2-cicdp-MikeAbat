# Copy to .env for reference, then set these variables in your shell.
# Django does not load .env automatically. Never reuse local/CI values for staging.
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generate-a-unique-local-secret>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=<local-database-name>
POSTGRES_USER=<local-database-user>
POSTGRES_PASSWORD=<local-database-password>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
